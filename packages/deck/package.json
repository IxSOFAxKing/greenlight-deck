{
  "private": true,
  "name": "greenlight-deck",
  "productName": "Greenlight Deck",
  "description": "Controller-first handheld frontend for Greenlight Xbox remote play and xCloud",
  "version": "0.4.4",
  "license": "MIT",
  "author": "Greenlight Deck contributors",
  "main": "dist-electron/main.cjs",
  "homepage": "https://github.com/IxSOFAxKing/greenlight-deck",
  "scripts": {
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "vite build",
    "build": "yarn build:main && yarn build:renderer",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json",
    "start": "yarn build && electron . --windowed",
    "dist": "yarn build && electron-builder --linux AppImage --publish never",
    "preview:ui": "vite --port 5199",
    "test:ui": "electron --no-sandbox scripts/smoke-test.cjs dist",
    "test:gamepad": "esbuild scripts/gamepad-test.ts --bundle --platform=node --format=esm --log-level=error --outfile=.cache/gamepad-test.mjs && node .cache/gamepad-test.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "43.2.0",
    "electron-builder": "^26.8.1",
    "esbuild": "*",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-qr-code": "^2.2.0",
    "typescript": "^5.9.3",
    "vite": "^8.1.0",
    "electron-updater": "^6.8.11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IxSOFAxKing/greenlight-deck.git"
  }
}
